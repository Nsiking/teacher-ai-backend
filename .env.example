# Copy this file to a new file named .env  (same folder) and fill in the values.
# Never upload .env to GitHub (it is already in .gitignore).

PORT=3000

# Put the AI key from console.anthropic.com here. Leave empty while testing with AI_MOCK=1
ANTHROPIC_API_KEY=

# 1 = fake AI answers (free, for testing the app flow). Remove or set 0 for real AI.
AI_MOCK=1

# A long secret only you know. Used to open the /admin page and admin API calls.
ADMIN_KEY=change-this-to-a-long-secret

# Models (free users get the cheaper one, paid users the better one)
AI_MODEL_FREE=claude-haiku-5-5
AI_MODEL_PAID=claude-sonnet-5-5

# Daily generation limits per user (resets at midnight Nigerian time)
FREE_DAILY_LIMIT=3
PAID_DAILY_LIMIT=30

# Where the database lives. Local: leave empty. On Render: /var/data
DATA_DIR=

# Set to off to hide the /test page once the real app is live
TEST_PAGE=on

# ---- Nightly backups to Cloudflare R2 (leave empty to switch backups off) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=smartclass-backups
# Folder inside the bucket, and how many days of backups to keep
R2_BACKUP_PREFIX=teacher-ai-backups/
BACKUP_KEEP_DAYS=30
